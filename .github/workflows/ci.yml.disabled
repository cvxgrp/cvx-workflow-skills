# Inactive template: GitHub discovers only .yml/.yaml files in this directory.
# Rename to ci.yml explicitly when the repository is close to public release.
name: CI

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v6
        with:
          version: "0.11.17"
          python-version: "3.14"
      - name: Install locked development dependencies
        run: uv sync --locked
      - name: Run tests
        run: uv run --no-sync python -m unittest discover -s tests -v
